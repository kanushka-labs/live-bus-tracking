{
  "name": "fleet-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "fleet-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F1.5",
    "F1.6",
    "F2.1",
    "F2.2",
    "F3.1",
    "F3.2"
  ],
  "description": "Owns buses, GPS devices, routes and stops, and the latest-position record per bus. Serves fleet/route management (F1) to fleet admins, accepts device-authenticated location updates (F2) from GPS devices in the field, and serves live position reads (F3) to the two web apps. Exposed to the internet because GPS devices report from outside the org network; device location updates authenticate with their own registered ID and secret, not through Thunder sign-in. Does not keep location history — only each bus's latest reported position.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "fleet-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "live-bus-tracking-fleet-db",
        "envBindings": {
          "dbname": "FLEET_DB_DBNAME",
          "host": "FLEET_DB_HOST",
          "password": "FLEET_DB_PASSWORD",
          "port": "FLEET_DB_PORT",
          "user": "FLEET_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "live-bus-tracking-be28433f",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "api-management"
  ]
}
